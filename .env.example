# Persistent SQLite database
DATABASE_PATH=data/jackpockets.db

# Provider credentials are optional. Add only keys you actually have.
# Hosted API access and billing are separate from consumer chat subscriptions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Stock footage search (optional)
PEXELS_API_KEY=

# Runtime tuning
REQUEST_TIMEOUT_SECONDS=90
MAX_PROVIDER_RETRIES=2
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
