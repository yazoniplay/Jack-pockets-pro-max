# Persistent SQLite database
DATABASE_PATH=data/jackpockets.db

# Gemini: research grounding and multimodal visual review
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama GPT-OSS. For Render, use Ollama Cloud and an API key.
# For a backend running on the same computer as Ollama, set:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Groq: fast story architecture, synthesis and script writing
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Stock footage search (optional)
PEXELS_API_KEY=

# Runtime tuning
REQUEST_TIMEOUT_SECONDS=90
MAX_PROVIDER_RETRIES=2
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
